# Server
PORT=4000

# Postgres connection string (Neon, Supabase, or any Postgres with pgvector)
DATABASE_URL=postgresql://user:password@host/dbname

# AI
# OpenRouter powers the LLM (document Q&A, summaries)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.5-flash

# Embeddings: OpenAI text-embedding-3-small is recommended.
# If OPENAI_API_KEY is empty, a deterministic local hashing fallback is used (still 1536-dim).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# App URL (sent as HTTP-Referer to OpenRouter)
APP_URL=http://localhost:4000

# Auth secrets
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Email (optional; password reset + agent invites are logged when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Smart PDF Workspace
MAIL_FROM_EMAIL=no-reply@djaouad.tech
FRONTEND_URL=http://localhost:3000
