# Server
PORT=4000

# Postgres connection string (Neon, Supabase, or any Postgres with pgvector)
DATABASE_URL=postgresql://user:password@host/dbname

# AI
# OpenRouter powers the LLM (document Q&A, summaries)
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=google/gemini-2.5-flash

# Embeddings: OpenAI text-embedding-3-small is required for semantic retrieval.
#
# Without OPENAI_API_KEY the app does NOT silently substitute a hash "embedding".
# A hash vector is a bucket, not a semantic vector, so cosine similarity over one
# returns confidently wrong answers. Instead, retrieval degrades to honest keyword
# scoring and every answer reports retrievalMode: "keyword-degraded".
# Set ALLOW_HASH_EMBEDDINGS=true only to opt into the legacy hash path; hash
# vectors are then tagged and refused by pgvector similarity search, so they are
# never searched — they are only stored for offline/diffing purposes.
#
# Check the live mode at any time: GET /health/embeddings
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
ALLOW_HASH_EMBEDDINGS=false

# Cosine similarity floor for the vector path. Lower = more (and less relevant)
# chunks retrieved. Keyword-degraded mode ignores this entirely.
RAG_SIMILARITY_THRESHOLD=0.25

# PDF ingest quality gate. pdf-parse reads the text layer only: there is no OCR,
# no table extraction and no layout analysis.
# PDF_MIN_CHARS_PER_PAGE: below this many characters of text per page, the PDF is
#   rejected as scanned/image-only (OCR required). Default 20.
# PDF_LOW_DENSITY_CHARS_PER_PAGE: below this, the PDF is indexed but flagged with
#   a low-text-density warning. Default 200.
PDF_MIN_CHARS_PER_PAGE=20
PDF_LOW_DENSITY_CHARS_PER_PAGE=200

# App URL (sent as HTTP-Referer to OpenRouter)
APP_URL=http://localhost:4000

# Auth secrets
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Email (optional; password reset + agent invites are logged when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Smart PDF Workspace
MAIL_FROM_EMAIL=no-reply@djaouad.tech
FRONTEND_URL=http://localhost:3000

# Public guest sandbox (no-login demo). Each visitor gets an isolated,
# short-lived workspace; expired sandboxes are purged automatically.
GUEST_TTL_MINUTES=120
GUEST_MAX_FILE_MB=5
GUEST_MAX_UPLOADS=3
